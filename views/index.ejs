<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Page</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="p-5 w-full min-h-screen bg-zinc-900 text-white">
        <div class="flex gap-5 max-h-[75px] w-full bg-zinc-700 items-center justify-between px-3 py-3 rounded-md">
            <% if(loggedInUser){ %>
                <div class="left flex gap-2 items-center justify-start">
                    <a class="w-9 h-9 rounded-md overflow-hidden" href="/profile">
                        <img class="w-full h-full object-cover" src="/images/uploads/<%= user.profilepic %>" alt="">
                    </a>
                    <h1 class="text-2xl"><a href="/">Quick Post</a></h1>
                </div>
                <div class="flex items-center justify-end gap-4">
                    <a class="bg-zinc-900 rounded-md px-3 py-2 inline-block" href="/profile">Your Profile</a>
                    
                    <a class="bg-zinc-900 rounded-md px-3 py-2 inline-block" href="/logout">Logout</a>
                </div>
                <% } else{ %>
                    <div class="left flex gap-2 items-center justify-start">
                        <a class="w-9 h-9 rounded-md overflow-hidden" href="/profile">
                            <img class="w-full h-full object-cover" src="/images/uploads/default.png" alt="">
                        </a>
                        <h1 class="text-2xl"><a href="/">Quick Post</a></h1>
                    </div>
                    <div class="routes flex gap-3">
                        <a class="bg-zinc-900 rounded-md px-3 py-2" href="/login">Login</a>
                        <a class="bg-zinc-900 rounded-md px-3 py-2" href="/register">Register</a>
                    </div>
            <% } %>
        </div>
        <div class="posts mt-10">
            <div class="postcontainer flex flex-wrap gap-5 justify-start">
                <% if(posts.length > 0){ %>
                    <% posts.reverse().forEach(function(post){ %>
                        <div class="post mb-4 w-[32%] p-4 border-[1px] border-zinc-700 bg-zinc-800 rounded-md">
                            <a class="text-blue-500 mb-2 inline-block" href="/user/<%= post.user.username %>">@<%= post.user.username %></a>
                            <p class="text-sm tracking-tight"><%= post.content %></p>
                            <small class="mt-2 block"><%= post.likes.length %> likes</small>
                            <div class="mt-1 btns flex gap-5">
                                <% if (userid) { %>
                                    <a class="cursor-pointer text-blue-500" href="/like/<%=post._id%>">
                                        <%= post.likes.indexOf(userid) === -1 ? "Like" : "Unlike" %>
                                    </a>
                                <% } else { %>
                                    <a class="cursor-pointer text-blue-500" href="/login">Login to Like</a>
                                <% } %>  
                            </div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <h4 class="text-zinc-400">Error occured!</h4>
                <% } %>   
            </div>
        </div>
    </div>
</body>
</html>