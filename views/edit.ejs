<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Page</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="p-5 w-full min-h-screen bg-zinc-900 text-white">
        <h5 class="mb-5">Edit your post</h5>
        <form action="/update/<%=post._id%>" method="post">
            <textarea name="content" class="w-1/2 px-3 py-2 resize-none bg-transparent border-zinc-800 border-2 rounded-md outline-none block" required><%= post.content %>
            </textarea>
            <input class="w-30 cursor-pointer text-black px-3 py-2 bg-yellow-600 rounded-md block mt-3" type="submit" value="Update Post">
        </form>
    </div>
</body>
</html>