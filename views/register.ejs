<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Page</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="p-5 w-full min-h-screen bg-zinc-900 text-white flex gap-5 flex-wrap flex-col content-center">
        <a class="cursor-pointer text-blue-500" href="/">Back to Home</a>
        <h1 class="text-3xl">Create Account</h1>
        <form action="/register" method="post" class="flex gap-2 flex-col flex-wrap content-center">
            <input class="w-100 px-3 py-2 rounded-md outline-none border-zinc-700 bg-transparent border-2" type="text" placeholder="Name" name="name">
            <input class="w-100 px-3 py-2 rounded-md outline-none border-zinc-700 bg-transparent border-2" type="text" placeholder="Username" name="username">
            <input class="w-100 px-3 py-2 rounded-md outline-none border-zinc-700 bg-transparent border-2" type="email" placeholder="Email" name="email">
            <input class="w-100 px-3 py-2 rounded-md outline-none border-zinc-700 bg-transparent border-2" type="number" placeholder="Age" name="age">
            <input class="w-100 px-3 py-2 rounded-md outline-none border-zinc-700 bg-transparent border-2" type="password" placeholder="Password" name="password">
            <input class="w-100 bg-blue-600 rounded-md px-3 py-2 mt-3 cursor-pointer" type="submit" value="Create Account">
        </form>
    </div>
</body>
</html>