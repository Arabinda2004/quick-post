<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Page</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="p-5 w-full min-h-screen bg-zinc-900 text-white">
        <div class="w-full flex justify-between">
            <a class="cursor-pointer text-blue-500" href="/">Back to Home</a>
            <a class="bg-red-600 rounded-md px-3 py-2 text-sm mb-5 inline-block" href="/logout">Logout</a>
        </div>
        <div class="flex flex-start gap-1">
            <a class="w-10 h-10 rounded-md overflow-hidden" href="/upload/profilepic/<%= user.username %>">
                <img class="w-full h-full object-cover" src="/images/uploads/<%= user.profilepic %>" alt="">
            </a>
            <h1 class="text-3xl"><span class="font-medium">Hello,</span> <%= user.name %> 👋🏻</h1>
        </div>
        <h5 class="mt-2 mb-5">You can create a new post</h5>
        <form action="/post" method="post">
            <textarea name="content" class="w-1/2 px-3 py-2 resize-none bg-transparent border-zinc-800 border-2 rounded-md outline-none block" placeholder="What's on your mind ?" required></textarea>
            <input class="w-30 cursor-pointer px-3 py-2 bg-blue-600 rounded-md block mt-3" type="submit" value="Post">
        </form>

        <div class="posts mt-15">
            <h2 class="text-white">Your Posts</h2>
            <div class="postcontainer mt-5">
                <% if(user.posts.length > 0){ %>
                    <% user.posts.reverse().forEach(function(post){ %>
                        <div class="post mb-4 w-1/3 p-4 border-[1px] border-zinc-700 bg-zinc-800 rounded-md">
                            <h4 class="text-blue-500 mb-2">@<%= user.username %></h4>
                            <p class="text-sm tracking-tight"><%= post.content %></p>
                            <small class="mt-2 block"><%= post.likes.length %> likes</small>
                            <div class="mt-1 btns flex gap-5">
                                <!-- <a class="cursor-pointer text-blue-500" href="/like/<%=post._id%>">
                                    <%= post.likes.indexOf(user._id) === -1 ? "Like" : "Unlike" %>
                                </a> -->
                                <a class="cursor-pointer text-zinc-400" href="/edit/<%= post._id %>">Edit</a>
                            </div>
                        </div>
                    <% }) %>
                <% } else {%>
                    <h4 class="text-zinc-400">No posts yet!</h4>
                <% } %>   
            </div>
        </div>
    </div>
</body>
</html>