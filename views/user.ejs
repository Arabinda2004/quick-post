<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Page</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="p-10 w-full min-h-screen bg-zinc-900 text-white">
        <a class="cursor-pointer text-blue-500" href="/">Back to Home</a>
        <div class="flex flex-col justify-center gap-4 items-center">
            <div class="w-50 h-50 rounded-md overflow-hidden">
                <img class="w-full h-full object-cover" src="/images/uploads/<%= user.profilepic %>">
            </div>
            <h1 class="text-3xl"><%= user.name %></h1>
        </div>

        <div class="posts mt-15">
            <h2 class="text-white"><%= user.name%>'s Posts</h2>
            <div class="postcontainer mt-5 flex flex-wrap gap-5 justify-start">
                <% if(user.posts.length > 0){ %>
                    <% user.posts.reverse().forEach(function(post){ %>
                        <div class="post mb-4 w-[32%] p-4 border-[1px] border-zinc-700 bg-zinc-800 rounded-md">
                            <a class="text-blue-500 mb-2 inline-block" href="/user/<%= user.username %>">@<%= user.username %></a>
                            <p class="text-sm tracking-tight"><%= post.content %></p>
                            <small class="mt-2 block"><%= post.likes.length %> likes</small>
                        </div>
                    <% }) %>
                <% } else {%>
                    <h4 class="text-zinc-400">No posts yet!</h4>
                <% } %>   
            </div>
        </div>
    </div>

    </div>
</body>
</html>